        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|cyan|success|warning|danger|neutral|ink|onInk)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'cyan' | 'success' | 'warning' | 'danger' | 'neutral' | 'ink' | 'onInk'."
